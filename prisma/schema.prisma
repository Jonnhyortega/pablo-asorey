// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("USER") // USER, ADMIN, STUDENT
  student   Student?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
}

model Student {
  id               String   @id @default(cuid())
  userId           String?  @unique
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  email            String?
  whatsapp         String   @default("")
  trainingDays     String
  sessionDuration  String
  birthDate        DateTime?
  height           Float
  weight           Float
  sportsExperience String
  injuries         String
  lastTraining     String
  goals            String
  gym              String
  photos           String   // JSON string of photo URLs
  paymentDate      DateTime?
  paymentStatus    String   @default("UP_TO_DATE") // UP_TO_DATE, PENDING, OVERDUE
  planId           String?
  plan             Plan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  generatedPassword String?
  profilePicture   String?
  routines         Routine[]
  notifications    StudentNotification[]
  xp               Int      @default(0)
  level            Int      @default(1)
  currentStreak    Int      @default(0)
  longestStreak    Int      @default(0)
  lastActivityDate DateTime?
  badges           StudentBadge[]
  selectedBadge    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Routine {
  id        String       @id @default(cuid())
  studentId String
  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  days      RoutineDay[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model RoutineDay {
  id          String     @id @default(cuid())
  routineId   String
  routine     Routine    @relation(fields: [routineId], references: [id], onDelete: Cascade)
  dayName     String
  order       Int
  completedAt DateTime?
  isSkipped   Boolean    @default(false)
  exercises   Exercise[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Exercise {
  id           String     @id @default(cuid())
  routineDayId String
  routineDay   RoutineDay @relation(fields: [routineDayId], references: [id], onDelete: Cascade)
  name         String
  order        Int        @default(0)
  sets_reps    String
  rest         String
  weight       String     @default("")
  loggedSets   String?    @default("[]")
  observations String     @default("")
  videoUrl     String     @default("")
  trackingType String     @default("REPS") // REPS, TIME
  isCompleted  Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model ExerciseLibrary {
  id        String   @id @default(cuid())
  name      String   @unique
  videoUrl  String?
  createdAt DateTime @default(now())
}

model AdminNotification {
  id        String   @id @default(cuid())
  type      String   // PAYMENT_REQUEST, SYSTEM, etc.
  title     String
  message   String
  read      Boolean  @default(false)
  studentId String?  // Optional reference to the student
  relatedDayId String? // Referencia al día que originó la notificación (para borrarla si se deshace)
  createdAt DateTime @default(now())
}

model StudentNotification {
  id        String   @id @default(cuid())
  type      String   // RECORD, PAYMENT_CONFIRMED, NEW_ROUTINE, DAY_COMPLETED
  title     String
  message   String
  read      Boolean  @default(false)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  relatedDayId String? // Referencia al día que originó la notificación (para borrarla si se deshace)
  createdAt DateTime @default(now())
}

model StudentBadge {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badgeId   String
  earnedAt  DateTime @default(now())
}

// Datos de contacto y textos de la landing editables desde /admin/settings.
// Fila única (id = 1); los campos vacíos usan los valores de src/config/site.ts.
model SiteSettings {
  id        Int      @id @default(1)
  whatsapp  String?
  email     String?
  instagram String?
  youtube   String?
  tagline   String?
  // Cobros: datos que ve el alumno para pagar y bloqueo opcional por deuda.
  paymentAlias    String?
  paymentAmount   String?  // En desuso: el monto sale del plan de cada alumno
  debtLockEnabled Boolean  @default(false)
  debtLockDays    Int      @default(7)
  updatedAt DateTime @updatedAt
}

// Catálogo de planes (servicios) con su precio mensual. Alimenta la sección de
// planes de la landing y el monto que ve cada alumno según su plan.
model Plan {
  id            String    @id @default(cuid())
  name          String
  price         Int       // ARS por mes
  icon          String    @default("dumbbell")
  logo          String?
  features      Json      @default("[]") // [{ text, icon }]
  highlight     Boolean   @default(false)
  showOnLanding Boolean   @default(true)
  active        Boolean   @default(true) // archivado = false: no se ofrece ni se asigna
  order         Int       @default(0)
  students      Student[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
